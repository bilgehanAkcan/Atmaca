{
  "name": "atmaca-command-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -s first \"vite\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "electron .",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "framer-motion": "13.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.185.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "^9.2.0",
    "electron": "44.4.5",
    "tailwindcss": "^4.3.0",
    "vite": "8.3.1",
    "wait-on": "^8.0.0"
  }
}
