# `glm` is the competition model (task PDF); `groq` is a backup. Never put a real key here.
LLM_PROVIDER=glm

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Image model for inspect_crop (GLM reads images itself)
GROQ_VISION_MODEL=qwen/qwen3.8-27b

GLM_BASE_URL=https://berriailitellm-databasev1826rc3-production-d691.up.railway.app/v1
GLM_API_KEY=
GLM_MODEL=glm-5.3-flash

LLM_REASONING_EFFORT=low
AGENT_MAX_TURNS=10
AGENT_MAX_PARALLEL_TOOLS=4
# Per question; a normal analysis uses ~30K tokens
AGENT_TOKEN_BUDGET=200000
DATA_DIR=data
ARTIFACTS_DIR=artifacts
DETECTOR_WEIGHTS=["weights/m_1280.pt","weights/m_1408.pt"]
DETECTOR_SIZES=[1408,1536,1664]
# Without weights, derive labelled stand-in detections from track end points
DETECTOR_FALLBACK_TO_TRACKS=true
